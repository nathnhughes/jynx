{
  "name": "jynx",
  "version": "1.3.3",
  "description": "Rapidly create and control responsive, theme-focused and type-safe styled-components, directly from your jsx.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/jynx.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "typescript",
    "css-in-js",
    "cssinjs",
    "css",
    "style-props",
    "styled-components",
    "emotion"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathnhughes/jynx.git"
  },
  "author": "Nathan Hughes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nathnhughes/jynx/issues"
  },
  "homepage": "https://jynx.vercel.app",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c",
    "build:dev": "if [ -e \"dist\" ];then rm -rf \"dist\"; fi && rollup -c",
    "watch": "rollup -c -w",
    "format": "prettier --write \"src/**/*.+(ts|tsx|js|jsx|md)\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "release": "shipjs prepare"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^5.0.1",
    "rollup": "^2.60.0",
    "rollup-plugin-dts": "^4.0.1",
    "rollup-plugin-esbuild": "^4.6.0",
    "shipjs": "0.25.1",
    "styled-components": "^6.6.0",
    "ts-essentials": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "deepmerge": "^4.2.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "styled-components": ">=5.1 <7"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@types/node": "17.0.33",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "rollup-plugin-dts": {
      "typescript": "$typescript"
    }
  }
}
